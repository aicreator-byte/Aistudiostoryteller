# Salin ke .env dan isi nilaimu sendiri. JANGAN commit .env ke Git!
# Dapatkan key gratis: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-ISI_KEY_KAMU_DISINI

# --- LLM langsung (tanpa router, berbayar) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# --- via NVIDIA / router ---
# Opsional — default sudah diisi di core.py:
# NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_JSON_MODEL=meta/llama-3.2-11b-vision-instruct

# Rantai fallback LLM (dicoba berurutan, gagal -> lanjut).
# Provider: nvidia, openrouter, 9router, omniroute
LLM_CHAIN=nvidia,openrouter
# Model OpenRouter :free (tanpa kartu kredit). Daftar berubah-ubah,
# cek: https://openrouter.ai/api/v1/models
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_API_KEY=sk-or-v1-... (atau via vault)

# Rantai video: langsung (kling,minimax,runway,luma), aggregator (fal,replicate),
# kenburns = slideshow foto+zoom (gratis, selalu jalan, fallback terakhir).
VIDEO_CHAIN=kenburns
# Aggregator:
# FAL_KEY=
# FAL_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=kwaivg/kling-v2.1
# Langsung:
# KLING_API_KEY= (stub — pakai fal/replicate untuk Kling)
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-Hailuo-02
# RUNWAY_API_KEY=
# RUNWAY_MODEL=gen4_turbo
# LUMA_API_KEY=
# LUMA_MODEL=ray-2
