# Salin ke .env dan isi nilaimu sendiri. JANGAN commit .env ke Git!
# Dapatkan key gratis: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-ISI_KEY_KAMU_DISINI
# Opsional — default sudah diisi di core.py:
# NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_JSON_MODEL=meta/llama-3.2-11b-vision-instruct

# Rantai fallback LLM (dicoba berurutan, gagal -> lanjut).
# Provider: nvidia, openrouter, 9router, omniroute
LLM_CHAIN=nvidia,openrouter
# Model OpenRouter :free (tanpa kartu kredit). Daftar berubah-ubah,
# cek: https://openrouter.ai/api/v1/models
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_API_KEY=sk-or-v1-... (atau via vault)

# Rantai video (saat ini: kenburns = slideshow foto + zoom).
# Provider AI beneran butuh API key berbayar — belum didukung.
VIDEO_CHAIN=kenburns
# Kunci provider video (disimpan, dipakai setelah adapternya ada):
# KLING_API_KEY=
# MINIMAX_API_KEY=
# RUNWAY_API_KEY=
# LUMA_API_KEY=
